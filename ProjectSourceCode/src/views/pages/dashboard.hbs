
<!-- Budget App Dashboard -->
<div class="container py-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Dashboard</h1>
      <p class="text-muted mb-0">
        Your financial overview
      </p>
    </div>

    <a href="/transactions" class="btn btn-primary">
      + Add Transaction
    </a>
  </div>

  <!-- Financial Summary Cards -->
  <div class="row g-3 mb-4">

    <!-- Balance -->
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h5 class="card-title text-muted">
            Total Balance
          </h5>
          <h2 class="card-text">
            ${{totalBalance}}
          </h2>
        </div>
      </div>
    </div>

    <!-- Income -->
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h5 class="card-title text-muted">
            Total Income
          </h5>
          <h2 class="card-text text-success">
            ${{totalIncome}}
          </h2>
        </div>
      </div>
    </div>

    <!-- Expenses -->
    <div class="col-md-4">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <h5 class="card-title text-muted">
            Total Expenses
          </h5>
          <h2 class="card-text text-danger">
            ${{totalExpenses}}
          </h2>
        </div>
      </div>
    </div>

  </div>

  <!-- Budget and Quick Actions -->
  <div class="row g-3 mb-4">

    <!-- Monthly Budget -->
    <div class="col-md-6">
      <div class="card h-100 shadow-sm">
        <div class="card-body">

          <h5 class="card-title">
            Monthly Budget
          </h5>

          <p class="text-muted">
            Spending progress this month
          </p>

          <div class="progress mb-3"
               role="progressbar"
               aria-label="Monthly budget used"
               aria-valuenow="{{budgetPercent}}"
               aria-valuemin="0"
               aria-valuemax="100">

            <div class="progress-bar"
                 style="width: {{budgetPercent}}%">
            </div>
          </div>

          <p>
            ${{budgetSpent}} spent of
            ${{budgetLimit}}
          </p>

          <a href="/budgets"
             class="btn btn-outline-primary">
            Manage Budgets
          </a>

        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-md-6">
      <div class="card h-100 shadow-sm">
        <div class="card-body">

          <h5 class="card-title mb-3">
            Quick Actions
          </h5>

          <div class="d-grid gap-2">

            <a href="/transactions"
               class="btn btn-outline-primary">
              View Transactions
            </a>

            <a href="/budgets"
               class="btn btn-outline-primary">
              Manage Budgets
            </a>

            <a href="/insights"
               class="btn btn-outline-primary">
              View Insights
            </a>

          </div>

        </div>
      </div>
    </div>

  </div>

  <!-- Recent Transactions -->
  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="card-title mb-0">
          Recent Transactions
        </h5>

        <a href="/transactions">
          View All
        </a>
      </div>

      {{#if transactions.length}}

        <div class="table-responsive">
          <table class="table table-hover">

            <thead>
              <tr>
                <th>Description</th>
                <th>Category</th>
                <th>Date</th>
                <th>Amount</th>
              </tr>
            </thead>

            <tbody>
              {{#each transactions}}
                <tr>
                  <td>{{this.description}}</td>
                  <td>{{this.category}}</td>
                  <td>{{this.date}}</td>
                  <td>${{this.amount}}</td>
                </tr>
              {{/each}}
            </tbody>

          </table>
        </div>

      {{else}}

        <p class="text-muted">
          No transactions to display yet.
        </p>

      {{/if}}

    </div>
  </div>

</div>
