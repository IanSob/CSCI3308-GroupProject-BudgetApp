
<!-- Budget App Dashboard -->
<div class="container py-4">

  
{{#if errorMessage}}
  <div class="alert alert-danger" role="alert">
    {{errorMessage}}
  </div>
{{else}}

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Dashboard</h1>
      <p class="text-muted mb-0">
        Your financial overview
      </p>
    </div>

    
<a href="/expenses" class="btn btn-dark">
  View Expenses
</a>

  </div>

 
<!-- Financial Summary Cards -->
<div class="row g-3 mb-4">

  <!-- Savings Card -->
  <div class="col-md-4">
    <div class="card h-100 shadow-sm">
      <div class="card-body">

        <h5 class="card-title text-muted">
          Recorded Savings
        </h5>

        <h2 class="card-text">
          ${{savingsAmount}}
        </h2>

        <a href="/financials" class="btn btn-outline-dark btn-sm">
          View Financials
        </a>

      </div>
    </div>
  </div>

  <!-- Income Sources Card -->
  <div class="col-md-4">
    <div class="card h-100 shadow-sm">
      <div class="card-body">

        <h5 class="card-title text-muted">
          Income Sources
        </h5>

        <h2 class="card-text text-success">
          {{incomeCount}}
        </h2>

        <a href="/financials" class="btn btn-outline-dark btn-sm">
          View Income
        </a>

      </div>
    </div>
  </div>

  <!-- Expenses Card -->
  <div class="col-md-4">
    <div class="card h-100 shadow-sm">
      <div class="card-body">

        <h5 class="card-title text-muted">
          Total Recorded Expenses
        </h5>

        <h2 class="card-text text-danger">
          ${{totalExpenses}}
        </h2>

        <a href="/expenses" class="btn btn-outline-dark btn-sm">
          View Expenses
        </a>

      </div>
    </div>
  </div>

</div>


  
<!-- Income and Quick Actions -->
<div class="row g-3 mb-4">

  <!-- Income Sources -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm">
      <div class="card-body">

        <h5 class="card-title mb-3">
          Income Sources
        </h5>

        {{#each incomes}}
          <div class="d-flex justify-content-between
                      align-items-center border-bottom py-2">

            <div>
              <strong>{{this.name}}</strong>
              <p class="text-muted small mb-0">
                {{this.type}}
              </p>
            </div>

            <span class="fw-semibold">
              ${{this.amount}}
            </span>

          </div>
        {{else}}
          <p class="text-muted">
            No income sources recorded yet.
          </p>
        {{/each}}

        <a href="/financials"
           class="btn btn-outline-dark mt-3">
          View Financials
        </a>

      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm">
      <div class="card-body">

        <h5 class="card-title mb-3">
          Quick Actions
        </h5>

        <div class="d-grid gap-2">

          <a href="/financials"
             class="btn btn-outline-dark">
            View Financials
          </a>

          <a href="/expenses"
             class="btn btn-outline-dark">
            View Expenses
          </a>

          <a href="/"
             class="btn btn-outline-dark">
            Return Home
          </a>

        </div>

      </div>
    </div>
  </div>

</div>


  
<!-- Recent Expenses -->
<div class="card shadow-sm mb-4">
  <div class="card-body">

    <div class="d-flex justify-content-between
                align-items-center mb-3">

      <h5 class="card-title mb-0">
        Recent Expenses
      </h5>

      <a href="/expenses">
        View All
      </a>

    </div>

    {{#if hasExpenses}}

      <div class="table-responsive">
        <table class="table table-hover">

          <thead>
            <tr>
              <th>Description</th>
              <th>Category</th>
              <th class="text-end">Amount</th>
            </tr>
          </thead>

          <tbody>
            {{#each recentExpenses}}
              <tr>
                <td>{{this.description}}</td>
                <td>{{this.category}}</td>
                <td class="text-end">
                  ${{this.amount}}
                </td>
              </tr>
            {{/each}}
          </tbody>

        </table>
      </div>

    {{else}}

      <p class="text-muted mb-0">
        No expenses to display yet.
      </p>

    {{/if}}

  </div>
  {{/if}}
</div>

</div>
