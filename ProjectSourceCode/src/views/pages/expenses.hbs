 <div class="container mt-5">
    <h1 class="mb-4">My Expenses</h1>

    <!-- Total Expenses -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Total Expenses</h5>
            <h3 id="total-expenses">${{totalExpenses}}</h3>
        </div>
    </div>

    <!-- Error Message -->
    {{#if errorMessage}}
        <div class="alert alert-danger">
            {{errorMessage}}
        </div>
    {{/if}}

    <!-- Success Message -->
    {{#if successMessage}}
        <div class="alert alert-success">
            {{successMessage}}
        </div>
    {{/if}}

    <!-- Add Expense Form -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Add an Expense</h5>

            <form action="/expenses" method="POST">
                <div class="mb-3">
                    <label for="expense_name" class="form-label">Expense Name</label>
                    <input
                        type="text"
                        class="form-control"
                        id="expense_name"
                        name="expense_name"
                        placeholder="e.g. Groceries"
                        maxlength="100"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="amount" class="form-label">Amount ($)</label>
                    <input
                        type="number"
                        class="form-control"
                        id="amount"
                        name="amount"
                        placeholder="e.g. 25.50"
                        min="0.01"
                        step="0.01"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <select
                        class="form-select"
                        id="category"
                        name="category"
                        required
                    >
                        <option value="" disabled selected>Select a category</option>
                        <option value="Food">Food</option>
                        <option value="Transportation">Transportation</option>
                        <option value="Entertainment">Entertainment</option>
                        <option value="Shopping">Shopping</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Add Expense
                </button>
            </form>
        </div>
    </div>

    <!-- Recurring Expense Success Message -->
    {{#if recurringSuccessMessage}}
        <div class="alert alert-success">
            {{recurringSuccessMessage}}
        </div>
    {{/if}}

    <!-- Add Recurring Expense Form -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Add a Recurring Expense</h5>
            <p class="text-muted">
                Set up an expense that automatically gets recorded on a schedule.
            </p>

            <form action="/recurring-expenses" method="POST">
                <div class="mb-3">
                    <label for="recurring_expense_name" class="form-label">
                        Expense Name
                    </label>
                    <input
                        type="text"
                        class="form-control"
                        id="recurring_expense_name"
                        name="expense_name"
                        placeholder="e.g. Monthly Subscription"
                        maxlength="100"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="recurring_amount" class="form-label">
                        Amount ($)
                    </label>
                    <input
                        type="number"
                        class="form-control"
                        id="recurring_amount"
                        name="amount"
                        placeholder="e.g. 15.99"
                        min="0.01"
                        max="99999999.99"
                        step="0.01"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="recurring_category" class="form-label">
                        Category
                    </label>
                    <select
                        class="form-select"
                        id="recurring_category"
                        name="category"
                        required
                    >
                        <option value="" disabled selected>
                            Select a category
                        </option>
                        <option value="Food">Food</option>
                        <option value="Transportation">Transportation</option>
                        <option value="Entertainment">Entertainment</option>
                        <option value="Shopping">Shopping</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="frequency" class="form-label">
                        Frequency
                    </label>
                    <select
                        class="form-select"
                        id="frequency"
                        name="frequency"
                        required
                    >
                        <option value="" disabled selected>
                            Select a frequency
                        </option>
                        <option value="weekly">Weekly</option>
                        <option value="biweekly">Every Two Weeks</option>
                        <option value="monthly">Monthly</option>
                        <option value="yearly">Yearly</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="start_date" class="form-label">
                        First Payment Date
                    </label>
                    <input
                        type="date"
                        class="form-control"
                        id="start_date"
                        name="start_date"
                        required
                    >
                </div>

                <button type="submit" class="btn btn-primary">
                    Add Recurring Expense
                </button>
            </form>
        </div>
    </div>

    <!-- Recurring Expense Schedules -->
    <div class="mb-4">
        <h3 class="mb-3">My Recurring Expenses</h3>

        {{#if hasRecurringExpenses}}
            <div class="row">
                {{#each recurringExpenses}}
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    {{expense_name}}
                                </h5>

                                <h4 class="card-text">${{amount}}</h4>

                                <p class="card-text">
                                    Category: {{category}}
                                </p>

                                <p class="card-text">
                                    Frequency:
                                    <span class="text-capitalize">{{frequency}}</span>
                                </p>

                                <p class="card-text">
                                    First Payment: {{start_date}}
                                </p>

                                {{#if active}}
                                    <p class="card-text">
                                        Next Payment: {{next_due_date}}
                                    </p>
                                    <span class="badge bg-success">Active</span>
                                {{else}}
                                    <span class="badge bg-secondary">Stopped</span>
                                {{/if}}

                                <details class="mt-3">
                                    <summary class="btn btn-outline-primary btn-sm">
                                        Edit Recurring Expense
                                    </summary>

                                    <form
                                        action="/recurring-expenses/{{recurring_expense_id}}/edit"
                                        method="POST"
                                        class="mt-3"
                                    >
                                        <div class="mb-3">
                                            <label class="form-label">
                                                Expense Name
                                            </label>
                                            <input
                                                type="text"
                                                class="form-control"
                                                name="expense_name"
                                                value="{{expense_name}}"
                                                maxlength="100"
                                                required
                                            >
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Amount ($)
                                            </label>
                                            <input
                                                type="number"
                                                class="form-control"
                                                name="amount"
                                                value="{{amount}}"
                                                min="0.01"
                                                max="99999999.99"
                                                step="0.01"
                                                required
                                            >
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Category
                                            </label>
                                            <select
                                              class="form-select"
                                              name="category"
                                              required
                                        >
                                              <option value="Food" {{#if (eq category "Food")}}selected{{/if}}>Food</option>
                                              <option value="Transportation" {{#if (eq category "Transportation")}}selected{{/if}}>Transportation</option>
                                              <option value="Entertainment" {{#if (eq category "Entertainment")}}selected{{/if}}>Entertainment</option>
                                              <option value="Shopping" {{#if (eq category "Shopping")}}selected{{/if}}>Shopping</option>
                                              <option value="Other" {{#if (eq category "Other")}}selected{{/if}}>Other</option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Frequency
                                            </label>
                                            <select
                                              class="form-select"
                                              name="frequency"
                                              required
                                            >
                                              <option value="weekly" {{#if (eq frequency "weekly")}}selected{{/if}}>Weekly</option>
                                              <option value="biweekly" {{#if (eq frequency "biweekly")}}selected{{/if}}>Every Two Weeks</option>
                                              <option value="monthly" {{#if (eq frequency "monthly")}}selected{{/if}}>Monthly</option>
                                              <option value="yearly" {{#if (eq frequency "yearly")}}selected{{/if}}>Yearly</option>
                                            </select>
                                            <small class="text-muted">
                                                Choose the schedule's new frequency.
                                            </small>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                First Payment Date
                                            </label>
                                            <input
                                                type="date"
                                                class="form-control"
                                                name="start_date"
                                                value="{{start_date}}"
                                                required
                                            >
                                        </div>

                                        <button type="submit" class="btn btn-primary btn-sm">
                                            Save Changes
                                        </button>
                                    </form>
                                </details>
                                <div class="mt-3 d-flex gap-2">
                                    {{#if active}}
                                        <form
                                            action="/recurring-expenses/{{recurring_expense_id}}/stop"
                                            method="POST"
                                        >
                                            <button
                                                type="submit"
                                                class="btn btn-warning btn-sm"
                                            >
                                                Stop
                                            </button>
                                        </form>
                                    {{/if}}

                                    <form
                                        action="/recurring-expenses/{{recurring_expense_id}}/delete"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this recurring expense?')"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-danger btn-sm"
                                        >
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <p class="text-muted">
                You don't have any recurring expenses set up yet.
            </p>
        {{/if}}
    </div>

    <!-- Individual Expense Cards -->
    <div id="expenses-container" class="row">
        {{#if hasExpenses}}
            {{#each expenses}}
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{expense_name}}</h5>
                            <h4 class="card-text">${{amount}}</h4>
                            <p class="card-text">
                                Category: {{category}}
                            </p>
                        </div>
                    </div>
                </div>
            {{/each}}
        {{else}}
            {{#unless errorMessage}}
                <div class="col-12 text-center">
                    <p>You don't have any expenses recorded yet.</p>
                </div>
            {{/unless}}
        {{/if}}
    </div>
</div>