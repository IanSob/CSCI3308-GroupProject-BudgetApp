 <div class="container mt-5">
    <h1 class="mb-4">My Expenses</h1>

    <!-- Total Expenses -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Total Expenses</h5>
            <h3 id="total-expenses">${{totalExpenses}}</h3>
        </div>
    </div>

    <!-- Error Message -->
    {{#if errorMessage}}
        <div class="alert alert-danger">
            {{errorMessage}}
        </div>
    {{/if}}

    <!-- Success Message -->
    {{#if successMessage}}
        <div class="alert alert-success">
            {{successMessage}}
        </div>
    {{/if}}

    <!-- Add Expense Form -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Add an Expense</h5>

            <form action="/expenses" method="POST">
                <div class="mb-3">
                    <label for="expense_name" class="form-label">Expense Name</label>
                    <input
                        type="text"
                        class="form-control"
                        id="expense_name"
                        name="expense_name"
                        placeholder="e.g. Groceries"
                        maxlength="100"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="amount" class="form-label">Amount ($)</label>
                    <input
                        type="number"
                        class="form-control"
                        id="amount"
                        name="amount"
                        placeholder="e.g. 25.50"
                        min="0.01"
                        step="0.01"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <select
                        class="form-select"
                        id="category"
                        name="category"
                        required
                    >
                        <option value="" disabled selected>Select a category</option>
                        <option value="Food">Food</option>
                        <option value="Transportation">Transportation</option>
                        <option value="Entertainment">Entertainment</option>
                        <option value="Shopping">Shopping</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Add Expense
                </button>
            </form>
        </div>
    </div>

    <!-- Individual Expense Cards -->
    <div id="expenses-container" class="row">
        {{#if hasExpenses}}
            {{#each expenses}}
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{expense_name}}</h5>
                            <h4 class="card-text">${{amount}}</h4>
                            <p class="card-text">
                                Category: {{category}}
                            </p>
                        </div>
                    </div>
                </div>
            {{/each}}
        {{else}}
            {{#unless errorMessage}}
                <div class="col-12 text-center">
                    <p>You don't have any expenses recorded yet.</p>
                </div>
            {{/unless}}
        {{/if}}
    </div>
</div>