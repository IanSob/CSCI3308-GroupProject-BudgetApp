<h1>Savings and Accounts</h1>
 
{{! Total is now calculated from all savings accounts, so there is no edit button here }}
<div class="card my-3">
  <div class="card-body">
    <h5 class="card-title">Total Savings</h5>
    <p class="card-text mb-0">${{savings}}</p>
  </div>
</div>
 
<div class="row">
 
  {{! ===== RIGHT HALF: Savings/Accounts  ===== }}
  <div class="col-12 col-md-7">
    <section class="my-4">
      <h2 class="h4 border-bottom pb-2 mb-3">Savings/Accounts</h2>
 
      <div class="row g-2">
        {{#each savingsAccounts}}
          <div class="col-12 col-sm-6 col-lg-4">
            <div
              class="card h-100"
              role="button"
              style="cursor: pointer;"
              data-bs-toggle="modal"
              data-bs-target="#editSavingsModal"
              data-id="{{savingsid}}"
              data-name="{{accountname}}"
              data-amount="{{amount}}"
            >
              <div class="card-body p-2">
                <h6 class="card-title mb-1">{{accountname}}</h6>
                <p class="card-text small fw-semibold mb-0">${{amount}}</p>
              </div>
            </div>
          </div>
        {{else}}
          <p class="text-muted small">No savings accounts yet.</p>
        {{/each}}
      </div>
 
      {{! Add Savings button, styled as an empty card }}
      <div class="row g-2 mt-1">
        <div class="col-6 col-lg-4">
          <button
            type="button"
            class="card w-100 bg-transparent text-muted"
            style="border-style: dashed;"
            data-bs-toggle="modal"
            data-bs-target="#addSavingsModal"
            aria-label="Add savings account"
          >
            <div class="card-body p-2 d-flex align-items-center justify-content-center">
              <span class="fs-2 lh-1">+</span>
            </div>
          </button>
        </div>
      </div>
    </section>
  </div>
 
  {{! ===== LEFT HALF: Income ===== }}
  <div class="col-12 col-md-3">
    <section class="my-4">
      <h2 class="h4 border-bottom pb-2 mb-3">Income</h2>
 
      <div class="row g-2">
        {{#each incomes}}
          <div class="col-12 col-xl-6">
            <div
              class="card h-100"
              role="button"
              style="cursor: pointer;"
              data-bs-toggle="modal"
              data-bs-target="#editIncomeModal"
              data-id="{{incomeid}}"
              data-name="{{incomename}}"
              data-type="{{incometype}}"
              data-amount="{{amount}}"
            >
              <div class="card-body p-2">
                <h6 class="card-title mb-1">{{incomename}}</h6>
                <p class="card-text small text-muted mb-0">{{incometype}}</p>
                <p class="card-text small fw-semibold mb-0">${{amount}}</p>
              </div>
            </div>
          </div>
        {{else}}
          <p class="text-muted small">No income sources yet.</p>
        {{/each}}
      </div>
 
      {{! Add Income button, styled as an empty card }}
      <div class="row g-2 mt-1">
        <div class="col-6 col-xl-4">
          <button
            type="button"
            class="card w-100 bg-transparent text-muted"
            style="border-style: dashed;"
            data-bs-toggle="modal"
            data-bs-target="#addIncomeModal"
            aria-label="Add income"
          >
            <div class="card-body p-2 d-flex align-items-center justify-content-center">
              <span class="fs-2 lh-1">+</span>
            </div>
          </button>
        </div>
      </div>
    </section>
  </div>
 
</div>
 
{{! ===== Add Savings Modal ===== }}
<div
  class="modal fade"
  id="addSavingsModal"
  tabindex="-1"
  aria-labelledby="addSavingsModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <form id="addSavingsForm" action="/savings" method="POST">
        <div class="modal-header">
          <h5 class="modal-title" id="addSavingsModalLabel">Add Savings Account</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
 
        <div class="modal-body">
          <div class="mb-3">
            <label for="savingsName" class="form-label">Account Name</label>
            <input
              type="text"
              class="form-control"
              id="savingsName"
              name="accountName"
              maxlength="50"
              placeholder="e.g. Emergency Fund"
              required
            >
          </div>
 
          <div class="mb-3">
            <label for="savingsAmount" class="form-label">Amount Saved</label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input
                type="number"
                class="form-control"
                id="savingsAmount"
                name="amount"
                min="0"
                step="0.01"
                placeholder="0.00"
                required
              >
            </div>
          </div>
        </div>
 
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">Add</button>
        </div>
      </form>
    </div>
  </div>
</div>
 
{{! ===== Edit Savings Modal ===== }}
<div
  class="modal fade"
  id="editSavingsModal"
  tabindex="-1"
  aria-labelledby="editSavingsModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <form id="editSavingsForm" action="/savings/update" method="POST">
        <input type="hidden" id="editSavingsId" name="savingsId">
 
        <div class="modal-header">
          <h5 class="modal-title" id="editSavingsModalLabel">Edit Savings Account</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
 
        <div class="modal-body">
          <div class="mb-3">
            <label for="editSavingsName" class="form-label">Account Name</label>
            <input
              type="text"
              class="form-control"
              id="editSavingsName"
              name="accountName"
              maxlength="50"
              required
            >
          </div>
 
          <div class="mb-3">
            <label for="editSavingsAmount" class="form-label">Amount Saved</label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input
                type="number"
                class="form-control"
                id="editSavingsAmount"
                name="amount"
                min="0"
                step="0.01"
                required
              >
            </div>
          </div>
        </div>
 
        <div class="modal-footer">
          <button
            type="submit"
            class="btn btn-outline-danger me-auto"
            formaction="/savings/delete"
            formnovalidate
            onclick="return confirm('Remove this savings account?');"
          >
            Remove
          </button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>
 
{{! ===== Add Income Modal ===== }}
<div
  class="modal fade"
  id="addIncomeModal"
  tabindex="-1"
  aria-labelledby="addIncomeModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <form id="addIncomeForm" action="/income" method="POST">
        <div class="modal-header">
          <h5 class="modal-title" id="addIncomeModalLabel">Add Income</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
 
        <div class="modal-body">
          <div class="mb-3">
            <label for="incomeName" class="form-label">Income Name</label>
            <input
              type="text"
              class="form-control"
              id="incomeName"
              name="incomeName"
              maxlength="50"
              placeholder="e.g. Campus Job"
              required
            >
          </div>
 
          <div class="mb-3">
            <label for="incomeType" class="form-label">Income Type</label>
            <select class="form-select" id="incomeType" name="incomeType" required>
              <option value="Hourly">Hourly</option>
              <option value="Weekly">Weekly</option>
              <option value="Bi-Weekly">Bi-Weekly</option>
              <option value="Monthly" selected>Monthly</option>
            </select>
          </div>
 
          <div class="mb-3">
            <label for="incomeAmount" class="form-label">Amount</label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input
                type="number"
                class="form-control"
                id="incomeAmount"
                name="amount"
                min="0.01"
                step="0.01"
                placeholder="0.00"
                required
              >
            </div>
          </div>
        </div>
 
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">Add</button>
        </div>
      </form>
    </div>
  </div>
</div>
 
{{! ===== Edit Income Modal ===== }}
<div
  class="modal fade"
  id="editIncomeModal"
  tabindex="-1"
  aria-labelledby="editIncomeModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <form id="editIncomeForm" action="/income/update" method="POST">
        <input type="hidden" id="editIncomeId" name="incomeId">
 
        <div class="modal-header">
          <h5 class="modal-title" id="editIncomeModalLabel">Edit Income</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>
 
        <div class="modal-body">
          <div class="mb-3">
            <label for="editIncomeName" class="form-label">Income Name</label>
            <input
              type="text"
              class="form-control"
              id="editIncomeName"
              name="incomeName"
              maxlength="50"
              required
            >
          </div>
 
          <div class="mb-3">
            <label for="editIncomeType" class="form-label">Income Type</label>
            <select class="form-select" id="editIncomeType" name="incomeType" required>
              <option value="Hourly">Hourly</option>
              <option value="Weekly">Weekly</option>
              <option value="Bi-Weekly">Bi-Weekly</option>
              <option value="Monthly">Monthly</option>
            </select>
          </div>
 
          <div class="mb-3">
            <label for="editIncomeAmount" class="form-label">Amount</label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input
                type="number"
                class="form-control"
                id="editIncomeAmount"
                name="amount"
                min="0.01"
                step="0.01"
                required
              >
            </div>
          </div>
        </div>
 
        <div class="modal-footer">
          <button
            type="submit"
            class="btn btn-outline-danger me-auto"
            formaction="/income/delete"
            formnovalidate
            onclick="return confirm('Remove this income source?');"
          >
            Remove
          </button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>
 
<script>
  // Fill the edit modals with the values from the card that was clicked
  document
    .getElementById('editIncomeModal')
    .addEventListener('show.bs.modal', function (event) {
      const card = event.relatedTarget;
      document.getElementById('editIncomeId').value = card.dataset.id;
      document.getElementById('editIncomeName').value = card.dataset.name;
      document.getElementById('editIncomeType').value = card.dataset.type;
      document.getElementById('editIncomeAmount').value = card.dataset.amount;
    });
 
  document
    .getElementById('editSavingsModal')
    .addEventListener('show.bs.modal', function (event) {
      const card = event.relatedTarget;
      document.getElementById('editSavingsId').value = card.dataset.id;
      document.getElementById('editSavingsName').value = card.dataset.name;
      document.getElementById('editSavingsAmount').value = card.dataset.amount;
    });
</script>
 