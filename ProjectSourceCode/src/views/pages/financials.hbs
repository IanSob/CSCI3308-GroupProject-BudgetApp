<h1>Financials</h1>

<div class="card my-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <h5 class="card-title">Savings</h5>
      <p class="card-text mb-0">${{savings}}</p>
    </div>
    <button
      type="button"
      class="btn btn-primary"
      data-bs-toggle="modal"
      data-bs-target="#editSavingsModal"
    >
      Edit Savings
    </button>
  </div>
</div>

<div class="row">

  {{! ===== RIGHT HALF: Expenses  ===== }}
  <div class="col-12 col-md-6">
    <section class="my-4">
      <h2 class="h4 border-bottom pb-2 mb-3">Expenses</h2>

      {{! TODO: add expense cards here }}
    </section>
  </div>

  {{! ===== LEFT HALF: Income ===== }}
  <div class="col-12 col-md-6">
    <section class="my-4">
      <h2 class="h4 border-bottom pb-2 mb-3">Income</h2>

      <div class="row g-2">
        {{#each incomes}}
          <div class="col-6 col-xl-4">
            <div class="card h-100">
              <div class="card-body p-2">
                <h6 class="card-title mb-1">{{incomename}}</h6>
                <p class="card-text small text-muted mb-0">{{incometype}}</p>
                <p class="card-text small fw-semibold mb-0">${{amount}}</p>
              </div>
            </div>
          </div>
        {{else}}
          <p class="text-muted small">No income sources yet.</p>
        {{/each}}
      </div>
    </section>
  </div>

</div>

{{! ===== Edit Savings Modal ===== }}
<div
  class="modal fade"
  id="editSavingsModal"
  tabindex="-1"
  aria-labelledby="editSavingsModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <form id="editSavingsForm" action="/savings" method="POST">
        <div class="modal-header">
          <h5 class="modal-title" id="editSavingsModalLabel">Edit Savings</h5>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>

        <div class="modal-body">
          <div class="mb-3">
            <label for="savingsAction" class="form-label">Action</label>
            <select class="form-select" id="savingsAction" name="action">
              <option value="add" selected>Add to Savings</option>
              <option value="remove">Remove from Savings</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="savingsAmount" class="form-label">Amount</label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input
                type="number"
                class="form-control"
                id="savingsAmount"
                name="amount"
                min="0.01"
                step="0.01"
                placeholder="0.00"
                required
              >
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Cancel
          </button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>