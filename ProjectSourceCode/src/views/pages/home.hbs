<div class="ffs-home">
  <section class="ffs-home-hero" aria-labelledby="ffs-home-headline">
    <div class="ffs-home-hero-copy">
      <div class="ffs-home-kicker"><span></span> TRACK · SAVE · GROW</div>
      {{#if homeLoggedIn}}
        <p class="ffs-home-greeting">Welcome back, {{homeName}}!</p>
        <h1 id="ffs-home-headline">Your money,<br><em>made simple.</em></h1>
        <p class="ffs-home-intro">A clear place to check your savings, keep up with expenses, and stay in control of your finances.</p>
        <div class="ffs-home-buttons">
          <a class="ffs-home-button ffs-home-button-gold" href="/financials">View Financials <span aria-hidden="true">→</span></a>
          <a class="ffs-home-button ffs-home-button-outline" href="/expenses">Manage Expenses</a>
        </div>
      {{else}}
        <h1 id="ffs-home-headline">Take control of<br>your <em>finances.</em></h1>
        <p class="ffs-home-intro">Track income, manage expenses, organize savings, and make smarter financial decisions—all in one simple place.</p>
        <div class="ffs-home-buttons">
          <a class="ffs-home-button ffs-home-button-gold" href="/register">Get Started <span aria-hidden="true">→</span></a>
          <a class="ffs-home-button ffs-home-button-outline" href="#how-it-works">How It Works</a>
        </div>
      {{/if}}
      <p class="ffs-home-hero-note">Simple tools. A clearer financial picture.</p>
    </div>

    <div class="ffs-home-hero-visual" aria-label="A preview of a simple financial dashboard">
      <div class="ffs-home-visual-glow" aria-hidden="true"></div>
      <div class="ffs-home-laptop" aria-hidden="true">
        <div class="ffs-home-laptop-screen">
          <div class="ffs-home-mini-top"><span class="ffs-home-mini-logo"></span> Flash Financial Savings <span class="ffs-home-mini-dots">•••</span></div>
          <div class="ffs-home-mini-title">Financial overview</div>
          <div class="ffs-home-mini-tiles">
            <div><small>Savings</small><strong>{{#if homeLoggedIn}}{{#if savingsAvailable}}${{savings}}{{else}}—{{/if}}{{else}}$4,250{{/if}}</strong></div>
            <div><small>Income sources</small><strong>{{#if homeLoggedIn}}{{#if incomeAvailable}}{{incomeCount}}{{else}}—{{/if}}{{else}}3{{/if}}</strong></div>
            <div><small>Expenses</small><strong>{{#if homeLoggedIn}}{{#if expensesAvailable}}${{expenses}}{{else}}—{{/if}}{{else}}$2,180{{/if}}</strong></div>
          </div>
          <div class="ffs-home-mini-charts">
            <div class="ffs-home-mini-graph"><span>Track your progress</span><div class="ffs-home-mini-bars"><i style="height:35%"></i><i style="height:55%"></i><i style="height:42%"></i><i style="height:68%"></i><i style="height:61%"></i><i style="height:80%"></i><i style="height:95%"></i></div></div>
            <div class="ffs-home-mini-graph"><span>Your spending</span><div class="ffs-home-mini-donut"></div><div class="ffs-home-mini-lines"><i></i><i></i><i></i></div></div>
          </div>
          <div class="ffs-home-mini-disclaimer">Illustrative chart design</div>
        </div>
        <div class="ffs-home-laptop-base"></div>
      </div>
      <div class="ffs-home-floating-note"><span class="ffs-home-floating-check">✓</span><span>Make every dollar count.</span></div>
    </div>
  </section>

  <section class="ffs-home-section" aria-labelledby="ffs-quick-title">
    <div class="ffs-home-section-heading">
      <div><span class="ffs-home-eyebrow">YOUR TOOLS</span><h2 id="ffs-quick-title">Quick access</h2></div>
      <p>Everything you need, just one click away.</p>
    </div>
    <div class="ffs-home-link-grid">
      <a class="ffs-home-link-card" href="/financials"><span class="ffs-home-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V10M10 19V5M16 19v-8M22 19v-13"/></svg></span><span class="ffs-home-link-copy"><strong>Financials</strong><small>Review your finances and spending insights</small></span><span class="ffs-home-link-arrow">↗</span></a>
      <a class="ffs-home-link-card" href="/expenses"><span class="ffs-home-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9h10M7 13h7M7 17h4"/></svg></span><span class="ffs-home-link-copy"><strong>Expenses</strong><small>Add expenses and see where money goes</small></span><span class="ffs-home-link-arrow">↗</span></a>
      <a class="ffs-home-link-card" href="/financials"><span class="ffs-home-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 8.5c-1-.9-5-1.2-6 .6-1.7 3 7 1.9 6 5.4-.7 2.4-4.9 2.6-7 .9M12 5.5v13"/></svg></span><span class="ffs-home-link-copy"><strong>Income</strong><small>Keep track of your income sources</small></span><span class="ffs-home-link-arrow">↗</span></a>
      <a class="ffs-home-link-card" href="/financials"><span class="ffs-home-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10h18v10H3zM3 14h18M7 10V7c0-2 2-3 5-3s5 1 5 3v3"/></svg></span><span class="ffs-home-link-copy"><strong>Savings</strong><small>Manage your savings accounts</small></span><span class="ffs-home-link-arrow">↗</span></a>
    </div>
  </section>

  <section class="ffs-home-section" aria-labelledby="ffs-snapshot-title">
    <div class="ffs-home-section-heading">
      <div><span class="ffs-home-eyebrow">AT A GLANCE</span><h2 id="ffs-snapshot-title">Your financial snapshot</h2></div>
      {{#if homeLoggedIn}}<p>Totals from your recorded financial information.</p>{{else}}<p>Here's what your dashboard could look like.</p>{{/if}}
    </div>
    <div class="ffs-home-snapshot">
      {{#unless homeLoggedIn}}<div class="ffs-home-demo-label">Example data — create an account to see your own numbers</div>{{/unless}}
      {{#if partialData}}<div class="ffs-home-data-warning" role="status">Some financial details could not be loaded. The rest of Home is still available.</div>{{/if}}
      <div class="ffs-home-stat-grid">
        <div class="ffs-home-stat"><div class="ffs-home-stat-icon">$</div><div><small>Recorded savings</small><strong>{{#if homeLoggedIn}}{{#if savingsAvailable}}${{savings}}{{else}}Unavailable{{/if}}{{else}}$4,250.00{{/if}}</strong></div></div>
        <div class="ffs-home-stat"><div class="ffs-home-stat-icon">↗</div><div><small>Income sources</small><strong>{{#if homeLoggedIn}}{{#if incomeAvailable}}{{incomeCount}}{{else}}Unavailable{{/if}}{{else}}3{{/if}}</strong></div></div>
        <div class="ffs-home-stat"><div class="ffs-home-stat-icon">↘</div><div><small>Recorded expenses</small><strong>{{#if homeLoggedIn}}{{#if expensesAvailable}}${{expenses}}{{else}}Unavailable{{/if}}{{else}}$2,180.00{{/if}}</strong></div></div>
        <div class="ffs-home-stat"><div class="ffs-home-stat-icon">≡</div><div><small>Expense categories</small><strong>{{#if homeLoggedIn}}{{#if expensesAvailable}}{{categoryCount}}{{else}}Unavailable{{/if}}{{else}}5{{/if}}</strong></div></div>
      </div>
      {{#if homeLoggedIn}}
        <p class="ffs-home-accuracy">These are all-time recorded amounts and source counts, not monthly income or cash-flow estimates.</p>
      {{/if}}
    </div>
  </section>

  {{#if homeLoggedIn}}
  <section class="ffs-home-section" aria-labelledby="ffs-activity-title">
    <div class="ffs-home-section-heading"><div><span class="ffs-home-eyebrow">STAY INFORMED</span><h2 id="ffs-activity-title">Your activity</h2></div><a class="ffs-home-section-link" href="/financials">Explore Financials →</a></div>
    <div class="ffs-home-activity-grid">
      <div class="ffs-home-panel"><h3>Top spending categories</h3><p class="ffs-home-panel-sub">Based on your recorded expenses</p>
        {{#if expensesAvailable}}
          {{#if hasCategories}}
            {{#each categories}}
              <div class="ffs-home-category-row"><div class="ffs-home-category-label"><span>{{name}}</span><strong>${{amount}} · {{percent}}%</strong></div><div class="ffs-home-category-track"><div style="width: {{percent}}%;"></div></div></div>
            {{/each}}
          {{else}}<div class="ffs-home-empty">No expenses yet. <a href="/expenses">Add your first expense</a> to see your spending categories.</div>{{/if}}
        {{else}}<div class="ffs-home-empty">Category data is unavailable right now.</div>{{/if}}
      </div>
      <div class="ffs-home-panel"><div class="ffs-home-panel-head"><div><h3>Recent expenses</h3><p class="ffs-home-panel-sub">Your latest recorded items</p></div><a href="/expenses">View all</a></div>
        {{#if expensesAvailable}}
          {{#if hasRecentExpenses}}
            <div class="ffs-home-expense-list">{{#each recentExpenses}}<div class="ffs-home-expense-row"><div><strong>{{description}}</strong><small>{{category}}</small></div><span>−${{amount}}</span></div>{{/each}}</div>
          {{else}}<div class="ffs-home-empty">Nothing here yet. <a href="/expenses">Record an expense</a> to get started.</div>{{/if}}
        {{else}}<div class="ffs-home-empty">Recent expenses are unavailable right now.</div>{{/if}}
      </div>
    </div>
  </section>
  {{/if}}

  <section class="ffs-home-section ffs-home-how" id="how-it-works" aria-labelledby="ffs-how-title">
    <div class="ffs-home-section-heading"><div><span class="ffs-home-eyebrow">BUILD BETTER HABITS</span><h2 id="ffs-how-title">A simpler way to manage money</h2></div></div>
    <div class="ffs-home-how-grid"><div><b>01</b><h3>Record</h3><p>Add expenses and income sources as you go.</p></div><div><b>02</b><h3>Organize</h3><p>Keep your savings accounts and categories in one place.</p></div><div><b>03</b><h3>Understand</h3><p>Use your Financials page to see where your money goes.</p></div></div>
  </section>
</div>
